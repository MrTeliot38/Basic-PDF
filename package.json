{
  "name": "basic-pdf",
  "private": true,
  "version": "0.2.0",
  "description": "Basic PDF — Lecteur et éditeur PDF libre, gratuit, 100 % hors ligne et en français.",
  "author": "Basic PDF",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:electron": "tsc -p tsconfig.electron.json --noEmit && node scripts/build-electron.mjs",
    "build:desktop": "npm run build && npm run build:electron",
    "dist:win": "npm run build:desktop && electron-builder --win --x64 --publish never && node scripts/write-sha256.mjs",
    "cap:sync": "cap sync android",
    "dist:android": "node scripts/build-android.mjs",
    "preview": "vite preview --port 4173",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:electron": "playwright test -c playwright.electron.config.ts"
  },
  "build": {
    "appId": "fr.basicpdf.desktop",
    "productName": "Basic PDF",
    "copyright": "Projet personnel libre — Basic PDF",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Basic-PDF-Setup-${version}.exe"
    },
    "nsis": {
      "guid": "8b4f6e3a-2d1b-4c9a-9f4e-7a3c2d81e504",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Basic PDF",
      "uninstallDisplayName": "Basic PDF"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "Document PDF",
        "description": "Document PDF — Basic PDF",
        "role": "Editor",
        "mimeType": "application/pdf",
        "icon": "build/icon.png"
      }
    ]
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tesseract.js-data/fra": "^1.0.0",
    "lucide-react": "^0.544.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.19",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
